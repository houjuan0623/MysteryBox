{
  "name": "mysterybox",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,web -c cyan,magenta \"npm run dev -w @mysterybox/api\" \"npm run dev -w @mysterybox/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run test:http",
    "db:migrate": "npm run db:migrate -w @mysterybox/api",
    "db:seed": "npm run db:seed -w @mysterybox/api",
    "test:e2e": "playwright test",
    "test:http": "node scripts/http-smoke.mjs",
    "format": "prettier --write apps packages scripts *.json *.ts *.mjs",
    "db:init": "npm run db:init -w @mysterybox/api",
    "admin:role": "npm run admin:role -w @mysterybox/api --",
    "dev:admin": "npm run dev -w @mysterybox/admin",
    "lint": "eslint apps packages scripts",
    "format:check": "prettier --check apps packages scripts *.json *.ts *.mjs",
    "test:mongo": "RUN_MONGO_TESTS=1 npm run test -w @mysterybox/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "eslint": "^10.12.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.71.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "mongodb-memory-server": "^10.2.3"
  }
}
