# Copy to .env; never commit the completed file. Default modes do not call external providers.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
API_INTERNAL_URL=http://127.0.0.1:4000
AI_MODE=demo
PAYMENT_MODE=demo
EMAIL_MODE=demo
PREMIUM_PRICE_CENTS=299
FREE_DAILY_LIMIT=50
# Optional local MongoDB replica set: mongodb://127.0.0.1:27017/?replicaSet=rs0
# Run db:init then db:seed; production requires MongoDB.
MONGODB_URI=
MONGODB_DB=mysterybox
SESSION_SECRET=
# Production: same strong value on Web+API, trusted ingress must overwrite the selected IP header.
PROXY_SHARED_SECRET=
TRUSTED_CLIENT_IP_HEADER=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
RESEND_API_KEY=
RESEND_FROM=
# No real model tests until model, free-account-only constraints and fresh user-entered key are approved.
APP_LIVE_TEST=0
